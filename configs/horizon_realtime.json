  "latency_mode": "wall",
  "environment": {"control_hz": 20, "max_actions": 80, "reach_duration_s": 0.5,
                  "tolerance_mm": 0.5, "rotation_tolerance_deg": 1.0},
  "scenarios": [
    {"name": "static", "arrival_position_mm": 2, "arrival_rotation_deg": 3},
    {"name": "moving_target", "arrival_position_mm": 2, "target_speed_mm_s": 1}
  ]
}
