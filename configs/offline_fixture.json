{
  "suite": "fixture_comparison",
  "backend": "vla_eval.toy:make_bundle",
  "dataset": "data/fixture.npz",
  "small_checkpoint": "checkpoints/fixture_small.npz",
  "split": "test",
  "seeds": [0, 1],
  "methods": ["A", "B", "C", "D", "prior_only", "shuffled_prior"],
  "horizons": [16],
